; Minimal MDP for fast profiling
integrator              = md
dt                      = 0.002
nsteps                  = 100
cutoff-scheme           = Verlet
nstlist                 = 10
rlist                   = 1.0
rcoulomb                = 1.0
rvdw                    = 1.0
pbc                     = xyz
tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 0.1
ref_t                   = 300
pcoupl                  = no
